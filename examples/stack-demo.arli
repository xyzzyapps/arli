;; Arli Stack Operations Demo
;; Demonstrates Forth-like stack operations with arity-driven syntax

print "=== Stack Operations Demo ==="

;; dup - duplicate top of stack
print "dup 5:"
dup 5
print stack

;; swap - swap top two values
print "swap 1 2:"
swap 1 2
print stack

;; Arity-driven prefix operations
print "Stack arithmetic: + 1 2"
+ 1 2
print stack

;; Chained operations via arity
print "* + 1 2 3:"
* + 1 2 3
print stack

;; Using drop
print "drop 99:"
drop 99
print stack

;; Over: (a b) -> (a b a)
print "over 1 2:"
over 1 2
print stack

