;; Tensor logic on the Go backend.
;;
;; Pedro Domingos's tensor logic has one statement: a tensor equation.
;; A relation is a Boolean tensor. A Datalog rule is an Einstein sum
;; (join on the shared indices, project the rest away) followed by the
;; step function. A perceptron is the same equation on real numbers.
;;
;; Run:  cd go/arli && go run . ../../examples/tensor-logic.arli

;; A perceptron. Y = step(W[i] X[i])
;; W = [0.2, 1.9, -0.7, 3], X = [0, 1, 1, 0], so the dot product is 1.2.
define W (tensor 'i 0.2 1.9 -0.7 3)
define X (tensor 'i 0 1 1 0)
print tensor->list tensor-step tensor-project tensor-join W X 'i

;; The same contraction written as an einsum subscript.
define A (tensor '(i j) '(2 2) 1 2 3 4)
define B (tensor '(j k) '(2 2) 5 6 7 8)
print tensor->list (tensor-einsum "ij,jk->ik" A B)

;; Aunt(x,z) <- Sister(x,y), Parent(y,z)
;; Sister(0,1) and Parent(1,2) imply Aunt(0,2). The step function
;; turns the summed join back into a Boolean.
define Sister (tensor '(x y) '(3 3) 0 1 0  0 0 0  0 0 0)
define Parent (tensor '(y z) '(3 3) 0 0 0  0 0 1  0 0 0)
print tensor->list tensor-step tensor-project tensor-join Sister Parent 'y
