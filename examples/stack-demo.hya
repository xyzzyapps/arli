;; Hya Stack Operations Demo
;; Demonstrates Forth-like stack operations with arity-driven syntax

print "=== Stack Operations Demo ==="

;; dup - duplicate top of stack
print "dup 5 ->"
dup 5
print stack[-1]  ;; should be 5, stack has [5, 5]

;; Clear stack - print a value and keep it
print "---"
print "swap 1 2 ->"
swap 1 2
print "top:", stack[-1]  ;; 1
print "next:", stack[-2] ;; 2

;; Arity-driven arithmetic on stack
print "---"
print "Stack arithmetic: + 1 2"
+ 1 2
print "Result on stack:", stack[-1]  ;; 3

;; Chain operations via arity
print "---"
print "* + 1 2 3  ->  (* (+ 1 2) 3) = 9"
* + 1 2 3
print "Result on stack:", stack[-1]  ;; 9

;; Using drop
print "---"
print "drop removes top of stack"
drop 99
print "After drop, top:", stack[-1] if stack else "empty"

;; Over: (a b) -> (a b a)
print "---"
print "over duplicates second item"
print over 1 2  ;; prints (1, 2, 1) and leaves [1, 2, 1] on stack
