;; Hya common test: recursive functions
;;
;; test: recursive factorial without parens
defn-rec fact (n)
    if (= n 0)
        1
        * n fact (- n 1)
;; expect: <fn fact>
fact 5
;; expect: 120

;; test: recursive fibonacci without parens via defn
defn fib (n)
    if (= n 0)
        0
        if (= n 1)
            1
            + fib (- n 1) fib (- n 2)
;; expect: <fn fib>
fib 10
;; expect: 55






