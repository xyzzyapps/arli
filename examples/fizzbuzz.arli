;; FizzBuzz in Hya
;; Demonstrates arity-driven syntax + parens for special forms

(defn fizzbuzz (n)
    (let ((i 1))
        (while (<= i n)
            (do
                (if (= 0 % i 15)
                    print "FizzBuzz"
                    (if (= 0 % i 3)
                        print "Fizz"
                        (if (= 0 % i 5)
                            print "Buzz"
                            print i)))
                (set! i + i 1)))))

print "FizzBuzz from 1 to 20:"
fizzbuzz 20
